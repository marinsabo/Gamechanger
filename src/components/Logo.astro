---
/**
 * Vector redraw of the Game Changer d-pad mark (the legacy site only had a 200px PNG).
 * Four rounded arms, each tapering to a point toward the centre.
 */
interface Props {
  class?: string;
  /** Show the GAME CHANGER wordmark next to the mark. */
  wordmark?: boolean;
  /** Render the mark white-on-red (tile) instead of red. */
  tile?: boolean;
}
const { class: className, wordmark = true, tile = false } = Astro.props;
const arm = 'M37 9a5 5 0 0 1 5-5h16a5 5 0 0 1 5 5v21L50 43 37 30Z';
---

<span class:list={['logo', { 'logo--tile': tile }, className]}>
  <svg class="logo__mark" viewBox="0 0 100 100" aria-hidden="true">
    {tile && <rect width="100" height="100" rx="14" fill="var(--red)" />}
    <g fill={tile ? '#fff' : 'var(--red)'} transform={tile ? 'translate(50 50) scale(.72) translate(-50 -50)' : undefined}>
      {[0, 90, 180, 270].map((deg) => <path d={arm} transform={`rotate(${deg} 50 50)`} />)}
    </g>
  </svg>
  {
    wordmark && (
      <span class="logo__word">
        <span>Game</span>
        <span>Changer</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--text);
  }

  .logo__mark {
    width: 36px;
    height: 36px;
    flex: none;
  }

  .logo__word {
    display: grid;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
</style>
