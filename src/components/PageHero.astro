---
interface Props {
  kicker: string;
  title: string;
  lead?: string;
}
const { kicker, title, lead } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero__glow" aria-hidden="true"></div>
  <div class="page-hero__grid grid-bg" aria-hidden="true"></div>
  <div class="container page-hero__inner">
    <div class="page-hero__main">
      <slot name="before" />
      <p class="kicker">{kicker}</p>
      <h1 class="display-1 page-hero__title">{title}</h1>
      {lead && <p class="lead">{lead}</p>}
    </div>
    {Astro.slots.has('default') && <div class="page-hero__aside"><slot /></div>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(64px, 10vw, 128px) clamp(48px, 6vw, 80px);
  }

  .page-hero__glow {
    position: absolute;
    top: -40%;
    right: -10%;
    z-index: -1;
    width: min(70vw, 820px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 45 45 / 0.22), transparent 65%);
  }

  .page-hero__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.5;
  }

  .page-hero__inner {
    display: grid;
    gap: 32px;
    align-items: end;
  }

  @media (min-width: 900px) {
    .page-hero__inner {
      grid-template-columns: 1fr auto;
    }
  }

  .page-hero__main {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .page-hero__title {
    font-size: clamp(2.5rem, 6.4vw, 5.5rem);
    max-width: 16ch;
  }
</style>
