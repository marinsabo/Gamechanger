---
import type { GetStaticPaths } from 'astro';
import ArticlePage from '@/views/ArticlePage.astro';
import { getNews, slugOf } from '@/lib/news';

export const getStaticPaths = (async () => {
  const news = await getNews('en');
  return news.map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
---

<ArticlePage entry={entry} lang="en" />
