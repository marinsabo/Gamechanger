---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import PageHero from '@/components/PageHero.astro';
import { halls, isBreak, partnerLogo, partnerName, program, speakerById, speakerImage, type PersonRef } from '@/lib/data';
import { href, routes, withBase, useTranslations, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const hallAccent: Record<string, string> = { '2': 'var(--violet)', '3': 'var(--lime)', '4': 'var(--red)', '5': '#38bdf8', '6': '#fb923c' };
const speakerLink = (p: PersonRef) => (p.id ? href('speakers', lang, p.id) : undefined);
---

<Base
  lang={lang}
  title={t('program.title')}
  description={t('program.lead')}
  current="program"
  alternates={{ hr: withBase(routes.program.hr), en: withBase(routes.program.en) }}
>
  <PageHero kicker={t('program.kicker')} title={t('program.title')} lead={t('program.lead')}>
    <div class="date-card">
      <Icon name="calendar" size={22} />
      <div>
        <p class="mono date-card__day">12.10.2023</p>
        <p class="muted">Cinestar · Z Centar, Zagreb</p>
      </div>
    </div>
  </PageHero>

  <section class="section program" aria-label={t('program.title')}>
    <div class="container">
      <nav class="tabs" aria-label={t('program.allHalls')} data-tabs>
        <div class="tabs__list" role="tablist">
          {
            halls.map((hall, i) => (
              <a
                class="tabs__tab"
                href={`#hall-${hall.number}`}
                role="tab"
                id={`tab-${hall.number}`}
                aria-controls={`hall-${hall.number}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                style={`--accent:${hallAccent[hall.number]}`}
              >
                <span class="mono tabs__num">{hall.number.padStart(2, '0')}</span>
                <span class="tabs__name">{hall.name[lang]}</span>
              </a>
            ))
          }
        </div>
      </nav>

      {
        halls.map((hall) => {
          const logo = hall.partner ? partnerLogo(hall.partner) : undefined;
          return (
            <section class="hall" id={`hall-${hall.number}`} role="tabpanel" aria-labelledby={`tab-${hall.number}`} style={`--accent:${hallAccent[hall.number]}`}>
              <header class="hall__head">
                <div>
                  <p class="kicker hall__kicker">
                    {t('halls.hall')} {hall.number}
                  </p>
                  <h2 class="display-3 hall__title">{hall.name[lang]}</h2>
                </div>
                <dl class="hall__facts">
                  <div>
                    <dt>{hall.hosts.length > 1 ? t('halls.hosts') : t('halls.host')}</dt>
                    <dd>
                      {hall.hosts.map((h, i) => (
                        <>
                          {i > 0 && ', '}
                          {speakerLink(h) ? <a href={speakerLink(h)}>{h.name}</a> : h.name}
                        </>
                      ))}
                    </dd>
                  </div>
                  {logo && hall.partner && (
                    <div>
                      <dt>{t('halls.partner')}</dt>
                      <dd>
                        <Image src={logo} alt={partnerName(hall.partner)} widths={[140, 280]} sizes="140px" class="hall__partner" />
                      </dd>
                    </div>
                  )}
                </dl>
              </header>

              <ol class="timeline">
                {hall.sessions.map((s) => {
                  const pitch = s.pitch !== undefined ? program.pitches[String(s.pitch)] : undefined;
                  const sLogo = s.partner ? partnerLogo(s.partner) : undefined;
                  const brk = isBreak(s);
                  return (
                    <li class:list={['slot', { 'slot--break': brk }]}>
                      <div class="slot__time mono">
                        <time>{s.start}</time>
                        <span aria-hidden="true">–</span>
                        <time>{s.end}</time>
                      </div>
                      <div class="slot__body">
                        {s.tag && <p class="slot__tag">{s.tag[lang]}</p>}
                        <h3 class="slot__title">{s.title[lang]}</h3>
                        {s.speakers && (
                          <ul class="slot__speakers">
                            {s.speakers.map((p) => {
                              const sp = p.id ? speakerById.get(p.id) : undefined;
                              const inner = (
                                <>
                                  {sp && <Image src={speakerImage(sp.id)} alt="" widths={[64]} sizes="32px" class="slot__avatar" />}
                                  <span>{sp?.name ?? p.name}</span>
                                </>
                              );
                              return <li>{p.id ? <a href={speakerLink(p)}>{inner}</a> : <span>{inner}</span>}</li>;
                            })}
                          </ul>
                        )}
                        {pitch && pitch.text[lang].length > 0 && (
                          <details class="slot__pitch">
                            <summary>
                              {t('program.pitch')}
                              <Icon name="chevron" size={18} />
                            </summary>
                            <div class="slot__pitch-body">
                              {pitch.text[lang].map((p) => (
                                <p>{p}</p>
                              ))}
                              {pitch.url && (
                                <a class="link-arrow" href={pitch.url} rel="noopener" target="_blank">
                                  {t('program.visit')}
                                  <Icon name="arrow-up-right" />
                                </a>
                              )}
                            </div>
                          </details>
                        )}
                      </div>
                      {sLogo && s.partner && (
                        <div class="slot__partner">
                          <Image src={sLogo} alt={partnerName(s.partner)} widths={[120, 240]} sizes="110px" />
                        </div>
                      )}
                    </li>
                  );
                })}
              </ol>

              {hall.jury && (
                <div class="jury">
                  <h3>{t('program.jury')}</h3>
                  <ul>
                    {hall.jury.map((p) => (
                      <li>{speakerLink(p) ? <a href={speakerLink(p)}>{p.name}</a> : p.name}</li>
                    ))}
                  </ul>
                </div>
              )}
            </section>
          );
        })
      }
    </div>
  </section>
</Base>

<script>
  // Progressive enhancement: without JS every hall is listed; with JS the halls become tabs.
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[role="tab"]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
  document.documentElement.classList.add('has-tabs');

  function select(id: string, focus = false) {
    const tab = tabs.find((t) => t.hash === `#${id}`) ?? tabs[0];
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
    });
    panels.forEach((p) => (p.hidden = `#${p.id}` !== tab.hash));
    tab.scrollIntoView({ block: 'nearest', inline: 'center' });
    if (focus) tab.focus();
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', (e) => {
      e.preventDefault();
      history.replaceState(null, '', tab.hash);
      select(tab.hash.slice(1));
    });
    tab.addEventListener('keydown', (e) => {
      const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!dir) return;
      e.preventDefault();
      const next = tabs[(i + dir + tabs.length) % tabs.length];
      history.replaceState(null, '', next.hash);
      select(next.hash.slice(1), true);
    });
  });

  const fromHash = () => select(location.hash.slice(1) || panels[0].id);
  addEventListener('hashchange', fromHash);
  fromHash();
  if (location.hash) document.querySelector('[data-tabs]')?.scrollIntoView();
</script>

<style>
  .date-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: rgb(15 17 22 / 0.7);
  }

  .date-card :global(svg) {
    color: var(--red);
  }

  .date-card__day {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .program {
    padding-top: 0;
  }

  /* ---------- tabs ---------- */
  .tabs {
    position: sticky;
    top: var(--header-h);
    z-index: 10;
    margin-inline: calc(var(--gutter) * -1);
    padding: 12px var(--gutter);
    background: rgb(8 9 12 / 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .tabs__list {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tabs__tab {
    flex: 1 0 180px;
    display: grid;
    gap: 4px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }

  .tabs__tab:hover {
    border-color: var(--line-strong);
  }

  .tabs__tab[aria-selected='true'] {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .tabs__num {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .tabs__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1.25;
    text-transform: uppercase;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(html:not(.has-tabs)) .tabs__tab[aria-selected] {
    border-color: var(--line);
    background: none;
  }

  /* ---------- hall ---------- */
  .hall {
    padding-top: 48px;
  }

  :global(html:not(.has-tabs)) .hall + .hall {
    margin-top: 48px;
    border-top: 1px solid var(--line);
  }

  .hall__head {
    display: grid;
    gap: 24px;
    margin-bottom: 32px;
  }

  @media (min-width: 900px) {
    .hall__head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }

  .hall__kicker {
    color: var(--accent);
    margin-bottom: 12px;
  }

  .hall__title {
    text-transform: uppercase;
    max-width: 24ch;
  }

  .hall__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 40px;
  }

  .hall__facts dt {
    margin-bottom: 6px;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .hall__facts dd {
    font-weight: 500;
  }

  .hall__facts a {
    text-decoration: none;
  }

  .hall__facts a:hover {
    color: var(--accent);
  }

  .hall__facts :global(.hall__partner) {
    width: auto;
    max-width: 120px;
    max-height: 36px;
    object-fit: contain;
  }

  /* ---------- timeline ---------- */
  .timeline {
    display: grid;
    gap: 8px;
    padding: 0;
    list-style: none;
  }

  .slot {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }

  @media (min-width: 760px) {
    .slot {
      grid-template-columns: 130px 1fr auto;
      gap: 28px;
      padding: 24px 28px;
    }
  }

  .slot__time {
    display: flex;
    gap: 6px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent);
  }

  @media (min-width: 760px) {
    .slot__time {
      flex-direction: column;
      gap: 0;
    }

    .slot__time span {
      display: none;
    }

    .slot__time time + time {
      color: var(--text-faint);
      font-weight: 500;
    }
  }

  .slot__tag {
    margin-bottom: 6px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .slot__title {
    font-family: var(--font-sans);
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .slot__speakers {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
    padding: 0;
    list-style: none;
  }

  .slot__speakers li > * {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px 4px 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--text-muted);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .slot__speakers a:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .slot__speakers :global(.slot__avatar) {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 15%;
    filter: grayscale(1);
  }

  .slot__partner {
    display: flex;
    align-items: center;
  }

  .slot__partner :global(img) {
    width: auto;
    max-width: 110px;
    max-height: 32px;
    object-fit: contain;
    opacity: 0.6;
    filter: grayscale(1) brightness(1.6);
  }

  .slot--break {
    background: transparent;
    border-style: dashed;
    padding-block: 14px;
  }

  .slot--break .slot__title {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .slot--break .slot__time {
    color: var(--text-faint);
  }

  @media (min-width: 760px) {
    .slot--break .slot__time {
      flex-direction: row;
      gap: 6px;
    }

    .slot--break .slot__time span {
      display: inline;
    }
  }

  .slot__pitch {
    margin-top: 14px;
  }

  .slot__pitch summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    cursor: pointer;
    list-style: none;
  }

  .slot__pitch summary::-webkit-details-marker {
    display: none;
  }

  .slot__pitch summary :global(svg) {
    transition: transform 0.2s;
  }

  .slot__pitch[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  .slot__pitch-body {
    display: grid;
    gap: 12px;
    max-width: 70ch;
    margin-top: 14px;
    color: var(--text-muted);
    justify-items: start;
  }

  .jury {
    margin-top: 32px;
    padding: 24px 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .jury h3 {
    margin-bottom: 14px;
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .jury ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding: 0;
    list-style: none;
  }

  .jury a {
    text-decoration: none;
  }

  .jury a:hover {
    color: var(--accent);
  }
</style>
