---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import SpeakerCard from '@/components/SpeakerCard.astro';
import PageHero from '@/components/PageHero.astro';
import { halls, speakerAppearances, speakerHalls, speakerImage, speakers } from '@/lib/data';
import { href, routes, withBase, useTranslations, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const collator = new Intl.Collator(lang === 'hr' ? 'hr' : 'en');
// Sort by surname-ish (last word), which is how most conference line-ups are browsed.
const sorted = [...speakers].sort((a, b) => collator.compare(a.name.replace(/^.*\s/, ''), b.name.replace(/^.*\s/, '')));

const roleLabel = {
  host: lang === 'hr' ? 'Domaćin dvorane' : 'Hall host',
  jury: lang === 'hr' ? 'Član žirija' : 'Jury member',
};
const prettyUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<Base
  lang={lang}
  title={t('nav.speakers')}
  description={t('speakers.lead')}
  current="speakers"
  alternates={{ hr: withBase(routes.speakers.hr), en: withBase(routes.speakers.en) }}
>
  <PageHero kicker={t('speakers.kicker')} title={t('speakers.title')} lead={t('speakers.lead')}>
    <p class="count mono"><strong>{speakers.length}</strong> {t('speakers.count')}</p>
  </PageHero>

  <section class="section speakers-page" aria-label={t('nav.speakers')}>
    <div class="container">
      <div class="toolbar" data-toolbar>
        <label class="search">
          <Icon name="search" size={18} />
          <span class="visually-hidden">{t('speakers.search')}</span>
          <input type="search" placeholder={t('speakers.search')} data-search autocomplete="off" />
        </label>
        <div class="chips" role="group" aria-label={t('program.allHalls')}>
          <button type="button" class="chip" aria-pressed="true" data-hall="">{t('speakers.filter.all')}</button>
          {
            halls.map((hall) => (
              <button type="button" class="chip" aria-pressed="false" data-hall={hall.number}>
                <span class="mono">{hall.number.padStart(2, '0')}</span> {hall.short}
              </button>
            ))
          }
        </div>
      </div>

      <p class="status muted" aria-live="polite" data-status></p>

      <div class="grid" data-grid>
        {
          sorted.map((s, i) => (
            <SpeakerCard speaker={s} lang={lang} href={`#${s.id}`} halls={speakerHalls(s.id)} eager={i < 6} />
          ))
        }
      </div>
      <p class="empty muted" data-empty hidden>{t('speakers.empty')}</p>
    </div>
  </section>

  {
    sorted.map((s) => {
      const appearances = speakerAppearances(s.id);
      return (
        <template id={`bio-${s.id}`}>
          <div class="bio">
            <div class="bio__media">
              <Image src={speakerImage(s.id)} alt={s.name} widths={[360, 540]} sizes="(min-width: 800px) 300px, 60vw" />
            </div>
            <div class="bio__body">
              <h2 class="bio__name" id="bio-title">{s.name}</h2>
              {s.role[lang] && <p class="bio__role">{s.role[lang]}</p>}
              {appearances.length > 0 && (
                <div class="bio__section">
                  <h3>{t('speakers.sessions')}</h3>
                  <ul class="bio__sessions">
                    {appearances.map((a) => (
                      <li>
                        <a href={href('program', lang, `hall-${a.hall.number}`)}>
                          <span class="mono bio__time">
                            {a.session ? `${a.session.start}–${a.session.end}` : `${t('halls.hall')} ${a.hall.number}`}
                          </span>
                          <span>
                            {a.session ? a.session.title[lang] : roleLabel[a.role as 'host' | 'jury']}
                            <small>
                              {t('halls.hall')} {a.hall.number} · {a.hall.name[lang]}
                            </small>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              <div class="bio__section">
                <h3>{t('speakers.bio')}</h3>
                <div class="bio__text">
                  {(s.bio[lang].length ? s.bio[lang] : s.bio.hr).map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              </div>
              {s.links.length > 0 && (
                <ul class="bio__links">
                  {s.links.map((url) => (
                    <li>
                      <a href={url} rel="noopener" target="_blank">
                        <Icon name="globe" size={16} />
                        {prettyUrl(url)}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </template>
      );
    })
  }

  <dialog class="bio-dialog" aria-labelledby="bio-title" data-dialog>
    <button class="bio-dialog__close" type="button" data-close aria-label={t('nav.close')}>
      <Icon name="close" size={22} />
    </button>
    <div data-dialog-body></div>
  </dialog>
</Base>

<script>
  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('[data-speaker]')];
  const search = document.querySelector<HTMLInputElement>('[data-search]')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-hall]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const dialog = document.querySelector<HTMLDialogElement>('[data-dialog]')!;
  const body = dialog.querySelector<HTMLElement>('[data-dialog-body]')!;

  // ---------- filtering ----------
  let hall = '';
  const normalize = (s: string) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();

  function applyFilter() {
    const q = normalize(search.value.trim());
    let shown = 0;
    for (const card of cards) {
      const okHall = !hall || card.dataset.halls!.split(' ').includes(hall);
      const okText = !q || normalize(card.dataset.search!).includes(q);
      card.hidden = !(okHall && okText);
      if (!card.hidden) shown++;
    }
    empty.hidden = shown > 0;
    status.textContent = q || hall ? `${shown} / ${cards.length}` : '';
  }

  search.addEventListener('input', applyFilter);
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      hall = chip.dataset.hall!;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      applyFilter();
    }),
  );

  // ---------- bio dialog (deep-linkable via #speaker-id) ----------
  let lastFocus: HTMLElement | null = null;

  function open(id: string) {
    const tpl = document.getElementById(`bio-${id}`) as HTMLTemplateElement | null;
    if (!tpl) return;
    body.replaceChildren(tpl.content.cloneNode(true));
    lastFocus = document.activeElement as HTMLElement;
    if (!dialog.open) dialog.showModal();
    dialog.scrollTop = 0;
    document.title = `${body.querySelector('h2')?.textContent} · ${document.title.split(' · ').pop()}`;
  }

  const baseTitle = document.title;
  dialog.addEventListener('close', () => {
    document.title = baseTitle;
    if (location.hash) history.replaceState(null, '', location.pathname + location.search);
    lastFocus?.focus();
  });
  dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close(); // backdrop click
  });

  grid.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
    if (!link) return;
    e.preventDefault();
    const id = link.hash.slice(1);
    history.replaceState(null, '', `#${id}`);
    open(id);
  });

  const fromHash = () => location.hash.length > 1 && open(decodeURIComponent(location.hash.slice(1)));
  addEventListener('hashchange', fromHash);
  fromHash();
</script>

<style>
  .count {
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .count strong {
    display: block;
    font-size: clamp(3rem, 6vw, 4.5rem);
    line-height: 1;
    color: var(--text);
  }

  .speakers-page {
    padding-top: 0;
  }

  .toolbar {
    position: sticky;
    top: var(--header-h);
    z-index: 10;
    display: grid;
    gap: 12px;
    padding-block: 16px;
    margin-bottom: 24px;
    background: linear-gradient(var(--bg) 80%, transparent);
  }

  @media (min-width: 1000px) {
    .toolbar {
      grid-template-columns: 320px 1fr;
      align-items: center;
    }
  }

  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-muted);
    transition: border-color 0.2s;
  }

  .search:focus-within {
    border-color: var(--red);
  }

  .search input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: none;
    color: var(--text);
    outline: none;
  }

  .chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 2px;
    scrollbar-width: none;
  }

  .chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 6px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--text-muted);
    white-space: nowrap;
    transition:
      color 0.2s,
      background-color 0.2s,
      border-color 0.2s;
  }

  .chip .mono {
    color: var(--red);
    font-weight: 600;
  }

  .chip:hover {
    color: var(--text);
  }

  .chip[aria-pressed='true'] {
    border-color: var(--text);
    background: var(--text);
    color: var(--bg);
  }

  .status {
    min-height: 1.5em;
    margin-bottom: 8px;
    font-size: 0.875rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px 16px;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 40px 20px;
    }
  }

  .grid :global([hidden]) {
    display: none;
  }

  .empty {
    padding: 64px 0;
    text-align: center;
  }

  /* ---------- dialog ---------- */
  .bio-dialog {
    width: min(960px, calc(100vw - 32px));
    max-height: calc(100dvh - 48px);
    margin: auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    color: var(--text);
    box-shadow: var(--shadow-lg);
    overscroll-behavior: contain;
  }

  .bio-dialog::backdrop {
    background: rgb(0 0 0 / 0.7);
    backdrop-filter: blur(6px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .bio-dialog[open] {
      animation: pop 0.35s var(--ease-out);
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }

  .bio-dialog__close {
    position: sticky;
    top: 12px;
    float: right;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 12px 12px 0 0;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: rgb(15 17 22 / 0.8);
    backdrop-filter: blur(6px);
  }

  .bio-dialog__close:hover {
    border-color: var(--red);
    background: var(--red);
  }

  .bio-dialog :global(.bio) {
    display: grid;
    gap: 28px;
    padding: clamp(20px, 4vw, 40px);
  }

  @media (min-width: 800px) {
    .bio-dialog :global(.bio) {
      grid-template-columns: 300px 1fr;
      gap: 40px;
    }
  }

  .bio-dialog :global(.bio__media img) {
    width: 100%;
    max-width: 300px;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius);
    filter: grayscale(1);
  }

  @media (min-width: 800px) {
    .bio-dialog :global(.bio__media) {
      position: sticky;
      top: 40px;
      align-self: start;
    }
  }

  .bio-dialog :global(.bio__name) {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    text-transform: uppercase;
    padding-right: 48px;
  }

  .bio-dialog :global(.bio__role) {
    margin-top: 10px;
    font-size: 1.0625rem;
    color: var(--red);
    font-weight: 500;
  }

  .bio-dialog :global(.bio__section) {
    margin-top: 32px;
  }

  .bio-dialog :global(.bio__section h3) {
    margin-bottom: 14px;
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .bio-dialog :global(.bio__text) {
    display: grid;
    gap: 1em;
    color: #d4d7dd;
    line-height: 1.75;
  }

  .bio-dialog :global(.bio__sessions) {
    display: grid;
    gap: 8px;
    padding: 0;
    list-style: none;
  }

  .bio-dialog :global(.bio__sessions a) {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 16px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    font-weight: 500;
    line-height: 1.4;
    transition: border-color 0.2s;
  }

  .bio-dialog :global(.bio__sessions a:hover) {
    border-color: var(--red);
  }

  .bio-dialog :global(.bio__sessions small) {
    display: block;
    margin-top: 4px;
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--text-faint);
  }

  .bio-dialog :global(.bio__time) {
    font-size: 0.875rem;
    color: var(--red);
  }

  .bio-dialog :global(.bio__links) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
    padding: 0;
    list-style: none;
  }

  .bio-dialog :global(.bio__links a) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--text-muted);
  }

  .bio-dialog :global(.bio__links a:hover) {
    color: var(--text);
    border-color: var(--text);
  }
</style>
